    "jose": "^6.0.10",
    "multer": "^2.1.1",
    "prisma": "6.6.0",
    "redis": "^5.0.1",
    "sharp": "^0.34.1",
    "ws": "^8.18.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.14.1",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
