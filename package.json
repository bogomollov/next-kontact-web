{
  "name": "kontact-web",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"cd frontend && next dev --turbopack\" \"cd backend && nodemon --watch src --watch server.ts --exec npm run dev\""
  },
  "prisma": {
    "seed": "tsx backend/prisma/seed.ts"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "concurrently": "^10.0.3",
    "dotenv": "^16.5.0",
    "prisma": "^6.8.2",
    "tsx": "^4.19.2"
  }
}
