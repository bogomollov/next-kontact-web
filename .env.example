# Runtime environment
NODE_ENV=production

# Public URLs (NEXT_PUBLIC_* are also baked into the client bundle at build time)
NEXT_PUBLIC_URL=https://kontact-web.ru
NEXT_PUBLIC_API_URL=https://kontact-web.ru/api
NEXT_PUBLIC_WS_URL=wss://kontact-web.ru/ws
# INTERNAL_API_URL=http://backend:3001/api

# PostgreSQL
DB_USER=
DB_PASSWORD=
DB_PORT=5432
DB_NAME=postgres
# Use service hostname 'pgsql' inside Docker, '127.0.0.1' for local non-Docker
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@pgsql:5432/${DB_NAME}?schema=public

# Redis — use service hostname 'redis' inside Docker, '127.0.0.1' for local
REDIS_URL=redis://redis:6379

# JWT signing secret — generate with: openssl rand -base64 32
ACCESS_SECRET=
